---
import GitHub from '../icons/GitHub';
import LinkedIn from '../icons/LinkedIn';
import Link from '../react/Link';
import MyStory from '../astro/MyStory.astro';
import WhyWeb from '../astro/WhyWeb.astro';
---

<section class="max-w-4xl mx-auto my-12 md:my-24 px-4">
    <h2 id="about-me" class="text-5xl mb-6 font-title font-black tracking-wide">
        About me
    </h2>
    <MyStory />

    <h3 class="text-3xl mb-6 font-title font-black tracking-wide">
        Why web progamming?
    </h3>
    <WhyWeb />
    <div class="flex flex-col md:flex-row gap-4 mt-8 md:items-center">
        <span class="text-xl font-black">Find me on:</span>
        <div class="flex gap-4">
            <Link
                title="My GitHub repository"
                className=" bg-white px-3 py-2"
                target="_blank"
                href="https://github.com/cararcel"
                ><GitHub className="size-6" />GitHub
            </Link>
            <Link
                title="My LinkedIn profile"
                className="  bg-blue-600 text-white px-3 py-2"
                target="_blank"
                href="https://www.linkedin.com/in/arce-camila/"
                ><LinkedIn className="size-6 fill-current" /> LinkedIn
            </Link>
        </div>
    </div>
</section>
