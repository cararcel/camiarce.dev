---
import Card from '../react/Card';
import Link from '../react/Link';
---

<section class="max-w-4xl mx-auto my-12 md:my-24">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 gap-y-16 px-4">
        <Card className="group col-span-2 bg-white p-4 relative">
            <p class="text-5xl mb-6 font-black tracking-wide font-title">
                Hello,
            </p>
            <div class="text-2xl md:text-3xl font-bold">
                My name is:{' '}
                <h1
                    class="inline-block text-3xl md:text-4xl font-handwritten font-bold"
                >
                    Camila Arce
                </h1>
            </div>

            <div
                class="animate-scale duration-100 transition absolute -top-16 right-3 starburst border-2 border-black w-28 md:w-36 bg-green-400"
            >
                <div
                    class="flex justify-center items-center h-full w-full font-handwritten font-black text-lg md:text-xl text-center -rotate-12"
                >
                    Available
                    <br />
                    to
                    <br />
                    work
                </div>
            </div>
        </Card>
        <div class="col-span-2 grid gap-6">
            <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-2 gap-6">
                <span
                    class="flex w-full justify-center items-center font-title text-4xl sm:text-3xl"
                >
                    I speak
                </span>

                <div>
                    <Link
                        title="Switch to Spanish"
                        className=" bg-white hover:bg-red-500 hover:text-white px-3 py-2"
                        target="_self"
                        href="/es"
                        icon="🇨🇱"
                        label="Español"
                    />
                </div>

                <div>
                    <Link
                        title="Switch to English"
                        className=" bg-white hover:bg-red-500 hover:text-white px-3 py-2 "
                        target="_self"
                        href="/"
                        icon="🇬🇧"
                        label="English"
                    />
                </div>

                <div>
                    <Link
                        title="Switch to French"
                        className=" bg-white hover:bg-red-500 hover:text-white px-3 py-2"
                        target="_self"
                        href="/fr"
                        icon="🇧🇪"
                        label="Français"
                    />
                </div>
            </div>
        </div>
        <Card className="group bg-pink-400">
            <figure class="w-full flex justify-center flex-col">
                <div class="flex justify-around items-end h-10 m-4">
                    <img
                        class="group-hover:animate-spin h-24"
                        src="/assets/img/blocks.png"
                        alt="My laptop"
                    />
                </div>
                <figcaption
                    class="flex-shrink w-full bg-white rounded-b-md text-md font-subtitle font-semibold tracking-wider border-t-2 border-black p-2"
                >
                    Web developer
                </figcaption>
            </figure>
        </Card>

        <Card className="group bg-green-300">
            <figure class="w-full h-full flex justify-center flex-col">
                <div class="flex justify-around items-end h-10 m-4">
                    <img
                        class="group-hover:animate-spin h-24"
                        src="/assets/img/microscope.webp"
                        srcset="/assets/img/microscope.webp, /assets/img/microscope@2x.webp 2x"
                        alt="One of my microscopes"
                    />
                </div>
                <figcaption
                    class="flex-shrink w-full h-full bg-white rounded-b-md text-md font-subtitle font-semibold tracking-wider border-t-2 border-black p-2"
                >
                    Biochemist
                </figcaption>
            </figure>
        </Card>

        <Card className="group bg-orange-400">
            <figure class="w-full flex justify-center flex-col">
                <div class="flex justify-around items-end h-10 m-4">
                    <img
                        class="group-hover:animate-spin h-24"
                        src="/assets/img/conito.webp"
                        srcset="/assets/img/conito.webp, /assets/img/conito@2x.webp 2x"
                        alt="A picture of one of my cats"
                    />
                    <img
                        class="group-hover:animate-spin h-24"
                        src="/assets/img/lilith.webp"
                        srcset="/assets/img/lilith.webp, /assets/img/lilith@2x.webp 2x"
                        alt="A picture of my other cat"
                    />
                </div>
                <figcaption
                    class="flex-shrink w-full bg-white rounded-b-md text-md font-semibold font-subtitle tracking-wider border-t-2 border-black p-2"
                >
                    Cat Lover
                </figcaption>
            </figure>
        </Card>

        <Card className="group bg-purple-400">
            <figure class="w-full flex justify-center flex-col">
                <div class="flex justify-around items-end h-10 m-4">
                    <img
                        class="group-hover:animate-spin h-24"
                        src="/assets/img/muffin.webp"
                        alt="Muffin from Bluey tv show"
                    />
                </div>
                <figcaption
                    class="flex-shrink w-full bg-white rounded-b-md text-md font-subtitle font-semibold tracking-wider border-t-2 border-black p-2"
                >
                    Mom
                </figcaption>
            </figure>
        </Card>
    </div>
</section>
