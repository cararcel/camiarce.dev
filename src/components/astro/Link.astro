---
const { label, icon, className = '', ...rest } = Astro.props;
---

<a
    {...rest}
    class={`font-extrabold rounded-full shadow-black-small hover:shadow-black-small-raised hover:-translate-x-1 hover:-translate-y-1 transition duration-150 ease-in-out border-2 border-black flex items-center gap-1 ${className}`}
>
    <slot />
    {icon && <span class="text-lg">{icon}</span>}
    {label && <span class="text-lg">{label}</span>}
</a>
