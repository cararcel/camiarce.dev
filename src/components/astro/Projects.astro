---
import ColorSwatch from "../icons/ColorSwatch";
import Debugging from "../icons/Debugging";
import LinkIcon from "../icons/Link";
import MobilePhone from "../icons/MobilePhone";
import Seo from "../icons/Seo";
import Link from "../astro/Link.astro";
import Tag from "../astro/Tag.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import Project from "./Project.astro";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<section class="pb-24 px-4 max-w-4xl mx-auto">
  <h2 id="projects" class="text-5xl mb-6 font-title font-black tracking-wide">
    {t("Projects")}
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <Project
      name="Jedah's Website"
      imgName="jedaswebsite"
      githubUrl="https://github.com/cararcel/jedah"
      githubTitle={t("Check the GitHub repository")}
      className="border-cyan-600 bg-cyan-600"
    >
      <Fragment slot="tags">
        <Tag className="bg-blue-300">ReactJS</Tag>
        <Tag className="bg-red-200 text-red-950">Laravel</Tag>
        <Tag className="bg-indigo-200 text-indigo-950">Inertia.js</Tag>
        <Tag className="bg-cyan-300">Tailwind CSS</Tag>
        <Tag className="bg-yellow-200 text-yellow-950">Vite</Tag>
        <Tag>
          <MobilePhone className="size-5" />
          {t("Responsive design")}
        </Tag>
      </Fragment>
    </Project>
    <Project
      name="Pia Esthétique"
      imgName="pia-esthetique"
      githubUrl="https://github.com/cararcel/Pia-estetique"
      githubTitle={t("Check the GitHub repository")}
      className="border-yellow-800 bg-yellow-800"
    >
      <Fragment slot="tags">
        <Link
          title="Link to website"
          className="bg-white px-2 py-1 bg-white hover:bg-red-500 hover:text-white"
          target="_blank"
          href="https://pia-esthetique.netlify.app/"
          label="Link"
        >
          <LinkIcon className="size-5" />
        </Link>
        <Tag className="bg-black text-white">Astro</Tag>
        <Tag className="bg-cyan-300">TailwindCSS</Tag>
        <Tag className="bg-yellow-400">JavaScript</Tag>
        <Tag>
          <MobilePhone className="size-5" />
          {t("Responsive design")}
        </Tag>
      </Fragment>
    </Project>
    <Project
      name="Booki"
      imgName="booki"
      githubUrl="https://github.com/cararcel/oc-p2-booki"
      githubTitle={t("Check the GitHub repository")}
      className="border-pink-400 bg-pink-400"
    >
      <Fragment slot="tags">
        <Link
          title="Link to website"
          className="bg-white px-2 py-1 bg-white hover:bg-red-500 hover:text-white"
          target="_blank"
          href="https://cararcel.github.io/oc-p2-booki/"
          label="Link"
        >
          <LinkIcon className="size-5" />
        </Link>
        <Tag className="bg-orange-400"> HTML </Tag>
        <Tag className="bg-blue-300"> CSS</Tag>
        <Tag> <MobilePhone className="size-5" />{t("Responsive design")}</Tag>
        <Tag> <ColorSwatch className="size-5" />{t("Design integration")}</Tag>
      </Fragment>
    </Project>
    <Project
      name="Nina Carducci"
      imgName="nina-carducci"
      githubUrl="https://github.com/cararcel/Nina-Carducci-Dev"
      githubTitle={t("Check the GitHub repository")}
      className="border-purple-400 bg-purple-400"
    >
      <Fragment slot="tags">
        <Tag className="bg-orange-400"> HTML </Tag>
        <Tag className="bg-blue-300"> CSS</Tag>
        <Tag className="bg-yellow-400"> Javascript</Tag>
        <Tag> <Debugging className="size-5" />{t("Debugging")}</Tag>
        <Tag> <Seo className="size-5" /> SEO</Tag>
      </Fragment>
    </Project>
    <Project
      name="Kasa"
      imgName="kasa"
      githubUrl="https://github.com/cararcel/kasa-oc-p5"
      githubTitle={t("Check the GitHub repository")}
      className="border-orange-400 bg-orange-400"
    >
      <Fragment slot="tags">
        <Tag className="bg-blue-300"> ReactJS </Tag>
        <Tag className="bg-pink-400"> SCSS</Tag>
        <Tag> <MobilePhone className="size-5" />{t("Responsive design")}</Tag>
        <Tag> <ColorSwatch className="size-5" /> Design integration</Tag>
      </Fragment>
    </Project>
    <Project
      name="Sophie Bluel"
      imgName="sophie-bluel"
      githubUrl="https://github.com/cararcel/oc-p3-portfolio-architecte-sophie-bluel"
      githubTitle={t("Check the GitHub repository")}
      className="border-green-400 bg-green-400"
    >
      <Fragment slot="tags">
        <Tag className="bg-orange-400"> HTML </Tag>
        <Tag className="bg-blue-300"> CSS</Tag>
        <Tag className="bg-yellow-400"> JavaScript</Tag>
        <Tag> <ColorSwatch className="size-5" />{t("Design integration")}</Tag>
      </Fragment>
    </Project>
  </div>
</section>
