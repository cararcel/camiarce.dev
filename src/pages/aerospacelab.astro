---
import Banner from "../components/astro/content/Banner.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/astro/content/Header.astro";
import AboutMe from "../components/astro/content/AboutMe.astro";
import Projects from "../components/astro/Projects.astro";
import Footer from "../components/astro/content/Footer.astro";
import CookieBanner from "../components/react/CookieBanner.jsx";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import MyStory from "../components/astro/content/MyStory.astro";
import WhyWeb from "../components/astro/content/WhyWeb.astro";
import Link from "../components/astro/Link.astro";
import GitHub from "../components/icons/GitHub";
import LinkedIn from "../components/icons/LinkedIn";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout>
  <Header />
  <Banner />
  <section class="px-4 max-w-4xl mx-auto my-12 md:my-24">
    <h2 id="about-me" class="text-5xl mb-6 font-title font-black tracking-wide">
      {t("About me")}
    </h2>
    <MyStory />

    <h3 class="text-3xl mb-6 font-title font-black tracking-wide">
      {t("Why web programming?")}
    </h3>
    <WhyWeb />

    <h3 class="text-3xl mb-6 font-title font-black tracking-wide">
      Why aerospacelab?
    </h3>
    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      I am constantly amazed by the invisible architecture of the internet—the
      millions of lines of code written by countless developers since the dawn
      of computing that allow me to type this message. That realization sparked
      a desire in me: I don't just want to consume technology; I want to be part
      of that lineage. I want to build something tangible, something I can look
      at and say, "I helped create that," with the same pride I felt when I
      successfully defended my thesis.
    </p>
    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      While many developers come from a pure CS background, I bring a different
      toolkit. As a former Biochemist, I don't just write code; I treat problems
      like experiments. I am trained to analyze complex, noisy data, form
      hypotheses, and iterate until I find the root cause. Whether you are
      debugging a frontend component or processing satellite imagery, the
      scientific method is the same: observe, test, and refine.
    </p>

    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      I know I don't know everything about aerospace yet. But I know how to
      learn. I have successfully navigated a complete career pivot, balanced
      motherhood with upskilling, and adapted to life in four different
      countries. I am willing to put in the hard work, embrace the "work hard,
      play hard" culture, and learn faster than anyone expects.
    </p>
    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      Aerospacelab isn't just another job to me. It is the rare opportunity to
      merge my two greatest passions: the rigor of science and the creativity of
      software. I am ready to bring my unique perspective to your team and
      contribute to software that literally helps us see the Earth from a new
      angle.

      <div class="flex flex-col md:flex-row gap-4 mt-8 md:items-center">
        <span class="text-xl font-black">{t("Find me on")}:</span>
        <div class="flex gap-4">
          <Link
            title={t("My GitHub repository")}
            className=" bg-white px-3 py-2"
            target="_blank"
            href="https://github.com/cararcel"
            ><GitHub className="size-6" />GitHub
          </Link>
          <Link
            title={t("My LinkedIn profile")}
            className="  bg-blue-600 text-white px-3 py-2"
            target="_blank"
            href="https://www.linkedin.com/in/arce-camila/"
            ><LinkedIn className="size-6 fill-current" /> LinkedIn
          </Link>
        </div>
      </div>
    </p>
    <Projects />
    <Footer />
    <CookieBanner client:load trans={t("cookie")} />
  </section>
</Layout>
