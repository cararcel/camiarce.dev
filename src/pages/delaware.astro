---
import Banner from "../components/astro/content/Banner.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/astro/content/Header.astro";
import AboutMe from "../components/astro/content/AboutMe.astro";
import Projects from "../components/astro/Projects.astro";
import Footer from "../components/astro/content/Footer.astro";
import CookieBanner from "../components/react/CookieBanner.jsx";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import MyStory from "../components/astro/content/MyStory.astro";
import WhyWeb from "../components/astro/content/WhyWeb.astro";
import Link from "../components/astro/Link.astro";
import GitHub from "../components/icons/GitHub";
import LinkedIn from "../components/icons/LinkedIn";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout>
  <Header />
  <Banner />
  <section class="px-4 max-w-4xl mx-auto my-12 md:my-24">
    <h2 id="about-me" class="text-5xl mb-6 font-title font-black tracking-wide">
      {t("About me")}
    </h2>
    <MyStory />

    <h3 class="text-3xl mb-6 font-title font-black tracking-wide">
      {t("Why web programming?")}
    </h3>
    <WhyWeb />

    <h3 class="text-3xl mb-6 font-title font-black tracking-wide">
      Why Delaware?
    </h3>
    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      I discovered Delaware while searching for a company that truly invests in
      its people. What caught my attention wasn't just the technology—it was the
      culture. Your commitment to guiding junior developers, fostering growth
      from within, and creating an environment where employees can build a
      career (not just a job) aligns perfectly with what I'm looking for. Values
      like commitment, respect, and team spirit aren't just words on a
      website—they're the foundation of how I approach my work and my
      relationships.
    </p>

    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      There is a clear alignment between what Delaware stands for and what I can
      offer. The emphasis on adaptability, continuous learning, and diverse
      project work mirrors my own journey, from scientific research to web
      development, and living across four countries. I thrive in environments
      where change is constant and collaboration is key, and I believe that is
      exactly what Delaware offers its consultants and clients.
    </p>

    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      These values create the space for me to bring my full potential to the
      table. When commitment, respect, and team spirit are genuinely lived, they
      enable someone like me, with a scientific mindset, international
      perspective, and hunger to grow to contribute meaningfully from day one. I
      am ready to invest in Delaware the same way Delaware invests in its people
      (me), and I look forward to the opportunity to prove that this partnership
      will benefit everyone involved.
    </p>

    <div class="flex flex-col md:flex-row gap-4 mt-8 md:items-center">
      <span class="text-xl font-black">{t("Find me on")}:</span>
      <div class="flex gap-4">
        <Link
          title={t("My GitHub repository")}
          className=" bg-white px-3 py-2"
          target="_blank"
          href="https://github.com/cararcel"
          ><GitHub className="size-6" />GitHub
        </Link>
        <Link
          title={t("My LinkedIn profile")}
          className="  bg-blue-600 text-white px-3 py-2"
          target="_blank"
          href="https://www.linkedin.com/in/arce-camila/"
          ><LinkedIn className="size-6 fill-current" /> LinkedIn
        </Link>
      </div>
    </div>
  </section>
  <Projects />
  <Footer />
  <CookieBanner client:load trans={t("cookie")} />
</Layout>
