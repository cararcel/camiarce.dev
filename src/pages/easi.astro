---
import Banner from "../components/astro/content/Banner.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/astro/content/Header.astro";
import AboutMe from "../components/astro/content/AboutMe.astro";
import Projects from "../components/astro/Projects.astro";
import Footer from "../components/astro/content/Footer.astro";
import CookieBanner from "../components/react/CookieBanner.jsx";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import MyStory from "../components/astro/content/MyStory.astro";
import WhyWeb from "../components/astro/content/WhyWeb.astro";
import Link from "../components/astro/Link.astro";
import GitHub from "../components/icons/GitHub";
import LinkedIn from "../components/icons/LinkedIn";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout>
  <Header />
  <Banner />
  <section class="px-4 max-w-4xl mx-auto my-12 md:my-24">
    <h2 id="about-me" class="text-5xl mb-6 font-title font-black tracking-wide">
      {t("About me")}
    </h2>
    <MyStory />

    <h3 class="text-3xl mb-6 font-title font-black tracking-wide">
      {t("Why web programming?")}
    </h3>
    <WhyWeb />

    <h3 class="text-3xl mb-6 font-title font-black tracking-wide">
      Why Novable?
    </h3>
    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      I am particularly interested in Novable because of your focus on
      transforming complex data into actionable insights that drive innovation.
      The idea of building technology that helps organizations discover
      opportunities, identify trends, and make better strategic decisions
      strongly resonates with me.
    </p>

    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      My background in biochemistry trained me to work with complex systems,
      analyze data critically, and extract meaningful patterns, skills that
      translate directly into developing data-driven applications. Transitioning
      into web development, I have applied this same analytical mindset to
      designing and building scalable, structured software, including RESTful
      APIs, authentication systems, and dynamic user interfaces.
    </p>

    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      What draws me to Novable is the opportunity to contribute to a product
      that goes beyond traditional web applications. You are not only building
      software, you are building a platform that supports decision-making and
      innovation at scale. This aligns closely with how I approach development:
      not just writing code, but creating tools that solve real problems in a
      meaningful way.
    </p>
    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      I bring a combination of strong technical foundations (JavaScript, React,
      Node.js, MongoDB), a product-oriented mindset, and a high level of
      adaptability developed through international experience and continuous
      self-learning. I am comfortable navigating uncertainty, learning quickly,
      and contributing in collaborative, fast-moving environments.
    </p>
    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      I am particularly motivated by roles where technology is used to structure
      complexity and enable smarter decisions. This is exactly what Novable
      does, and why I see a strong alignment between your mission and the kind
      of developer I am becoming.
    </p>

    <div class="flex flex-col md:flex-row gap-4 mt-8 md:items-center">
      <span class="text-xl font-black">{t("Find me on")}:</span>
      <div class="flex gap-4">
        <Link
          title={t("My GitHub repository")}
          className=" bg-white px-3 py-2"
          target="_blank"
          href="https://github.com/cararcel"
          ><GitHub className="size-6" />GitHub
        </Link>
        <Link
          title={t("My LinkedIn profile")}
          className="  bg-blue-600 text-white px-3 py-2"
          target="_blank"
          href="https://www.linkedin.com/in/arce-camila/"
          ><LinkedIn className="size-6 fill-current" /> LinkedIn
        </Link>
      </div>
    </div>
  </section>
  <Projects />
  <Footer />
  <CookieBanner client:load trans={t("cookie")} />
</Layout>
