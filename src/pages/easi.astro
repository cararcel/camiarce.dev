---
import Banner from "../components/astro/content/Banner.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/astro/content/Header.astro";
import AboutMe from "../components/astro/content/AboutMe.astro";
import Projects from "../components/astro/Projects.astro";
import Footer from "../components/astro/content/Footer.astro";
import CookieBanner from "../components/react/CookieBanner.jsx";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import MyStory from "../components/astro/content/MyStory.astro";
import WhyWeb from "../components/astro/content/WhyWeb.astro";
import Link from "../components/astro/Link.astro";
import GitHub from "../components/icons/GitHub";
import LinkedIn from "../components/icons/LinkedIn";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout>
  <Header />
  <Banner />
  <section class="px-4 max-w-4xl mx-auto my-12 md:my-24">
    <h2 id="about-me" class="text-5xl mb-6 font-title font-black tracking-wide">
      {t("About me")}
    </h2>
    <MyStory />

    <h3 class="text-3xl mb-6 font-title font-black tracking-wide">
      {t("Why web programming?")}
    </h3>
    <WhyWeb />

    <h3 class="text-3xl mb-6 font-title font-black tracking-wide">Why Odoo?</h3>
    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      Because I live 3km from the office (in the Fram2), and to be honest, the
      first approach that you have with the company is the website. And I love
      it. I know I'm judging the book by its cover, but that means that you have
      very nice developers.
    </p>
    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      And now a little bit more seriously. When I took the decision to retrain
      myself as a web developer, I did it because I wanted a job that could give
      me a safe and stable place to work, where maybe I could work from home
      sometimes, and where I could have a nice work-life balance. And I think
      that is the first thing that I saw when I looked into Odoo's culture.
    </p>

    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      And last but not least, "It's ok to fail. It's not ok not to evolve." I
      think that is a powerful and motivating statement from Odoo, and it shows
      me that this is a place where I want to work. I'm looking for a place
      where I can be honest about what I don't know yet, and where that's okay.
      And I have a lot of experience in evolving, and trying, and reinventing
      myself, because that is the only motor to keep going. It's in my DNA.
    </p>
    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      That's why I believe I'd be a good fit: I bring the discipline of a
      scientist to code. I don't cut corners, I document my process, and I treat
      debugging as a systematic investigation rather than a guessing game. You
      get a developer who understands that accuracy today prevents bugs
      tomorrow, paired with the humility to ask for help and the drive to turn
      that guidance into independence. I'm ready to start as a junior dev, do
      the work, and grow into a long-term asset for the team.

      <div class="flex flex-col md:flex-row gap-4 mt-8 md:items-center">
        <span class="text-xl font-black">{t("Find me on")}:</span>
        <div class="flex gap-4">
          <Link
            title={t("My GitHub repository")}
            className=" bg-white px-3 py-2"
            target="_blank"
            href="https://github.com/cararcel"
            ><GitHub className="size-6" />GitHub
          </Link>
          <Link
            title={t("My LinkedIn profile")}
            className="  bg-blue-600 text-white px-3 py-2"
            target="_blank"
            href="https://www.linkedin.com/in/arce-camila/"
            ><LinkedIn className="size-6 fill-current" /> LinkedIn
          </Link>
        </div>
      </div>
    </p>
    <Projects />
    <Footer />
    <CookieBanner client:load trans={t("cookie")} />
  </section>
</Layout>
