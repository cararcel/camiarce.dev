---
import Banner from "../components/astro/content/Banner.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/astro/content/Header.astro";
import AboutMe from "../components/astro/content/AboutMe.astro";
import Projects from "../components/astro/Projects.astro";
import Footer from "../components/astro/content/Footer.astro";
import CookieBanner from "../components/react/CookieBanner.jsx";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import MyStory from "../components/astro/content/MyStory.astro";
import WhyWeb from "../components/astro/content/WhyWeb.astro";
import Link from "../components/astro/Link.astro";
import GitHub from "../components/icons/GitHub";
import LinkedIn from "../components/icons/LinkedIn";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout>
  <Header />
  <Banner />
  <section class="px-4 max-w-4xl mx-auto my-12 md:my-24">
    <h2 id="about-me" class="text-5xl mb-6 font-title font-black tracking-wide">
      {t("About me")}
    </h2>
    <MyStory />

    <h3 class="text-3xl mb-6 font-title font-black tracking-wide">
      {t("Why web programming?")}
    </h3>
    <WhyWeb />

    <h3 class="text-3xl mb-6 font-title font-black tracking-wide">
      Why Qargo?
    </h3>
    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      What attracts me to Qargo is not only what you build, but how you build
      it. I’m drawn to your culture of ownership and pragmatism — working in
      environments where I can take responsibility early, contribute to real
      decisions, and improve through iteration rather than waiting for perfect
      solutions. I value team-oriented environments where ideas are shared
      openly and problems are solved collectively, and Qargo’s collaborative,
      low-hierarchy culture feels like a strong match for how I like to work.
    </p>

    <p class="text-lg text-justify text-black leading-8 tracking-wide mb-8">
      I believe I’m a good fit for Qargo because I bring strong analytical
      thinking, adaptability, and a hands-on approach to building and learning.
      My transition into software development, combined with my experience
      living and working in different countries, has made me comfortable with
      uncertainty, quick to learn, and proactive in taking ownership of my work.
      I’m currently focused on backend development and enjoy working on APIs,
      data flows, and system structure, areas that align closely with how Qargo
      builds its product. I’m looking for a place where I can contribute from
      the beginning, grow , and be part of a team building something meaningful,
      and Qargo represents the kind of environment where I can contribute from
      the beginning, grow quickly, and become a strong engineer over time.
    </p>

    <div class="flex flex-col md:flex-row gap-4 mt-8 md:items-center">
      <span class="text-xl font-black">{t("Find me on")}:</span>
      <div class="flex gap-4">
        <Link
          title={t("My GitHub repository")}
          className=" bg-white px-3 py-2"
          target="_blank"
          href="https://github.com/cararcel"
          ><GitHub className="size-6" />GitHub
        </Link>
        <Link
          title={t("My LinkedIn profile")}
          className="  bg-blue-600 text-white px-3 py-2"
          target="_blank"
          href="https://www.linkedin.com/in/arce-camila/"
          ><LinkedIn className="size-6 fill-current" /> LinkedIn
        </Link>
      </div>
    </div>
  </section>
  <Projects />
  <Footer />
  <CookieBanner client:load trans={t("cookie")} />
</Layout>
